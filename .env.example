# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional overrides
DOCQA_MODEL=claude-opus-5-5
DOCQA_EFFORT=medium
DOCQA_DATA_DIR=./data
DOCQA_TOP_K=6
DOCQA_MAX_FILE_MB=20
# Public demo protection (0 = unlimited; leave the access code empty for an open app)
DOCQA_MAX_QUESTIONS_PER_DAY=150
DOCQA_MAX_QUESTIONS_PER_SESSION=25
DOCQA_ACCESS_CODE=
